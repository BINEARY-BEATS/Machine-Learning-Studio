
    QWidget {
        font-family: "IBM Plex Sans", "Segoe UI", "SF Pro Text", system-ui, sans-serif;
        font-size: 13px;
        color: #1A2421;
    }
    QMainWindow, #CentralWidget, #GalleryRoot {
        background-color: #F3F5F4;
    }
    #Sidebar {
        background-color: #FFFFFF;
        border-right: 1px solid #C5D0CB;
    }
    #ContentArea { background-color: #F3F5F4; }
    #StatusBar {
        background-color: #FFFFFF;
        border-top: 1px solid #C5D0CB;
        color: #5C6B66;
        padding: 4px 12px;
    }
    #PageTitle { font-size: 18px; font-weight: 600; color: #1A2421; }
    #SectionTitle { font-size: 14px; font-weight: 600; color: #1A2421; }
    

    QPushButton#PrimaryButton {
        background-color: #0D9488;
        color: #FFFFFF;
        border: none;
        border-radius: 4px;
        padding: 8px 16px;
        font-weight: 600;
    }
    QPushButton#PrimaryButton:hover { background-color: #0F766E; }
    QPushButton#PrimaryButton:pressed { background-color: #0F766E; }
    QPushButton#PrimaryButton:disabled {
        background-color: #C5D0CB;
        color: #9AA8A3;
    }
    QPushButton#PrimaryButton:focus {
        outline: 2px solid #0D9488;
        outline-offset: 2px;
    }
    

    QPushButton#IconButton {
        background: transparent;
        border: 1px solid transparent;
        border-radius: 4px;
        padding: 8px;
        color: #5C6B66;
    }
    QPushButton#IconButton:hover {
        background-color: #EEF2F0;
        color: #1A2421;
        border-color: #DCE4E0;
    }
    QPushButton#IconButton:pressed { background-color: #DCE4E0; }
    QPushButton#IconButton:disabled { color: #9AA8A3; }
    QPushButton#IconButton:focus { border-color: #0D9488; }
    QPushButton#GhostButton {
        background: transparent;
        border: 1px solid #C5D0CB;
        border-radius: 4px;
        padding: 8px 16px;
        color: #1A2421;
    }
    QPushButton#GhostButton:hover { background-color: #EEF2F0; }
    

    QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
        background-color: #FFFFFF;
        border: 1px solid #C5D0CB;
        border-radius: 2px;
        padding: 8px 12px;
        color: #1A2421;
        selection-background-color: #CCFBF1;
    }
    QLineEdit:focus, QComboBox:focus { border-color: #0D9488; }
    QLineEdit#SearchBar {
        background-color: #EEF2F0;
        border: 1px solid #DCE4E0;
        border-radius: 9999px;
        padding: 8px 16px;
        padding-left: 32px;
    }
    QLineEdit#SearchBar:focus {
        border-color: #0D9488;
        background-color: #FFFFFF;
    }
    QComboBox QAbstractItemView {
        background-color: #FFFFFF;
        color: #1A2421;
        selection-background-color: #0D9488;
        selection-color: #FFFFFF;
    }
    

    QTableView, QTableWidget {
        background-color: #FFFFFF;
        alternate-background-color: #EEF2F0;
        border: 1px solid #C5D0CB;
        gridline-color: #DCE4E0;
        color: #1A2421;
    }
    QHeaderView::section {
        background-color: #EEF2F0;
        border: none;
        border-bottom: 1px solid #C5D0CB;
        padding: 8px;
        font-weight: 600;
        color: #1A2421;
    }
    QScrollBar:vertical {
        background: #EEF2F0;
        width: 10px;
        border-radius: 2px;
    }
    QScrollBar::handle:vertical {
        background: #C5D0CB;
        border-radius: 2px;
        min-height: 24px;
    }
    

    #Card {
        background-color: #FFFFFF;
        border: 1px solid #C5D0CB;
        border-radius: 6px;
    }
    #CardHeader {
        color: #5C6B66;
        font-size: 12px;
        font-weight: 600;
    }
    

    QLabel#StatTitle { color: #5C6B66; font-size: 12px; }
    QLabel#StatValue { color: #1A2421; font-size: 22px; font-weight: 600; }
    QLabel#StatDelta { font-size: 11px; font-weight: 500; }
    

    #EmptyStateTitle { font-size: 16px; font-weight: 600; color: #1A2421; }
    #EmptyStateDescription { font-size: 13px; color: #5C6B66; }
    #ToastLabel {
        background-color: #EEF2F0;
        color: #1A2421;
        border: 1px solid #C5D0CB;
        border-radius: 4px;
        padding: 12px 16px;
        font-size: 13px;
    }
    #ToastLabel[toastVariant="success"] { border-color: #15803D; }
    #ToastLabel[toastVariant="danger"] { border-color: #DC2626; }
    #ToastLabel[toastVariant="warning"] { border-color: #B45309; }
    #LoadingMessage {
        color: #1A2421;
        font-size: 14px;
        font-weight: 600;
        background-color: #FFFFFF;
        border: 1px solid #C5D0CB;
        border-radius: 4px;
        padding: 16px 24px;
    }
    #SwatchLabel { font-size: 11px; color: #5C6B66; }
    

    QTabWidget::pane {
        background-color: #FFFFFF;
        border: 1px solid #C5D0CB;
        border-radius: 4px;
    }
    QTabBar::tab {
        background-color: #EEF2F0;
        color: #5C6B66;
        border: 1px solid #C5D0CB;
        padding: 8px 16px;
        border-top-left-radius: 2px;
        border-top-right-radius: 2px;
    }
    QTabBar::tab:selected {
        background-color: #FFFFFF;
        color: #1A2421;
        font-weight: 600;
    }
    

    QLabel#TagChip {
        border-radius: 9999px;
        padding: 4px 12px;
        font-size: 11px;
        font-weight: 600;
        background-color: #EEF2F0;
        color: #5C6B66;
        border: 1px solid #DCE4E0;
    }
    
    QLabel#TagChip[chipVariant="success"] {
        color: #15803D;
        background-color: #CCFBF1;
        border-color: #15803D;
    }
    
    QLabel#TagChip[chipVariant="warning"] {
        color: #B45309;
        background-color: #EEF2F0;
        border-color: #B45309;
    }
    
    QLabel#TagChip[chipVariant="danger"] {
        color: #DC2626;
        background-color: #EEF2F0;
        border-color: #DC2626;
    }
    
    QLabel#TagChip[chipVariant="info"] {
        color: #0E7490;
        background-color: #CCFBF1;
        border-color: #0E7490;
    }
    

    #LoadingOverlay { background-color: #0F14128C; }
    #TopBar {
        background-color: #FFFFFF;
        border-bottom: 1px solid #C5D0CB;
    }
    #Breadcrumb { color: #5C6B66; font-size: 12px; }
    #ProjectName {
        background-color: #EEF2F0;
        border: 1px solid #DCE4E0;
        border-radius: 2px;
        padding: 4px 8px;
    }
    #NavSection {
        color: #5C6B66;
        font-size: 10px;
        font-weight: 700;
        padding: 8px 12px 4px;
    }
    #StatusChip {
        color: #5C6B66;
        font-size: 11px;
        padding-left: 12px;
    }
    #ErrorBanner {
        color: #DC2626;
        background-color: #EEF2F0;
        border: 1px solid #DC2626;
        border-radius: 4px;
        padding: 12px;
    }
    QPushButton#PillTab {
        background-color: #EEF2F0;
        border: 1px solid #DCE4E0;
        border-radius: 4px;
        padding: 8px 16px;
        color: #5C6B66;
    }
    QPushButton#PillTab[active="true"] {
        background-color: #CCFBF1;
        border-color: #0D9488;
        color: #0D9488;
        font-weight: 600;
    }
    QPushButton#StepButton {
        background-color: #EEF2F0;
        border: 1px solid #DCE4E0;
        border-radius: 4px;
        padding: 4px 12px;
        color: #5C6B66;
        font-size: 11px;
    }
    QPushButton#StepButton[stepState="active"] {
        background-color: #0D9488;
        color: #FFFFFF;
        border-color: #0D9488;
    }
    QPushButton#StepButton[stepState="done"] {
        border-color: #15803D;
        color: #15803D;
    }
    #NavButton {
        text-align: left;
        padding: 8px 12px;
        border: none;
        border-left: 3px solid transparent;
        border-radius: 0px;
        background: transparent;
        color: #5C6B66;
    }
    #NavButton:hover {
        background-color: #EEF2F0;
        color: #1A2421;
    }
    #NavButton[active="true"] {
        background-color: #CCFBF1;
        border-left: 3px solid #0D9488;
        color: #0D9488;
        font-weight: 600;
    }
    #SidebarTitle {
        font-size: 14px;
        font-weight: 700;
        color: #1A2421;
        letter-spacing: 0.5px;
    }
    #RunStateChip {
        font-family: Consolas, 'Cascadia Mono', monospace;
        font-size: 10px;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 2px;
        border: 1px solid #C5D0CB;
        color: #5C6B66;
        background-color: #EEF2F0;
    }
    #RunStateChip[runState="idle"] { color: #5C6B66; }
    #RunStateChip[runState="profiling"] { color: #0E7490; border-color: #0E7490; }
    #RunStateChip[runState="training"] { color: #B45309; border-color: #B45309; }
    #RunStateChip[runState="failed"] { color: #DC2626; border-color: #DC2626; }
    #RunStateChip[runState="ready"] { color: #15803D; border-color: #15803D; }
    #MonoMetric {
        font-family: Consolas, 'Cascadia Mono', monospace;
        font-size: 13px;
        font-weight: 600;
        color: #1A2421;
    }
    #ReadinessRow {
        padding: 8px 0;
        border-bottom: 1px solid #DCE4E0;
    }
    QDialog, QListWidget {
        background-color: #FFFFFF;
        color: #1A2421;
        border: 1px solid #C5D0CB;
        border-radius: 4px;
    }
    